[submodule "tasks/common"]
	path = tasks/common
	url = git@github.com:abugher/ansible-common-tasks.git
[submodule "inventory"]
	path = inventory
	url = git@github.com:abugher/ansible-inventory.git
[submodule "environment"]
	path = environment
	url = git@github.com:abugher/ansible-environment.git
[submodule "certificate-authority"]
	path = certificate-authority
	url = git@github.com:abugher/certificate-authority.git
[submodule "sensitive-certificate-authority"]
	path = sensitive-certificate-authority
	url = ansible@files:/storage/control-center/sensitive-certificate-authority.git
